{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Automerge minor and patch updates once CI passes. 0.x releases may break on a minor bump, so they stay manual.",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^v?0\\./",
      "automerge": true
    }
  ]
}
